# ==============================================================================
# SecureAgent-SOC Environment Configuration
# ==============================================================================

# Project & Environment
PROJECT_NAME="SecureAgent-SOC"
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security & CORS
SECRET_KEY=secureagent_soc_super_secret_jwt_hmac_key_2026_dsu
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# API access: comma-separated keys sent as the X-API-Key header (empty = open, development only)
API_KEYS=
RATE_LIMIT_PER_MINUTE=0
AUTO_CREATE_TABLES=true

# PostgreSQL Database (Sync & Async)
POSTGRES_USER=secureagent
POSTGRES_PASSWORD=secureagent_secret_2026
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=secureagent_soc
DATABASE_URL=postgresql+asyncpg://secureagent:secureagent_secret_2026@localhost:5432/secureagent_soc
SYNC_DATABASE_URL=postgresql://secureagent:secureagent_secret_2026@localhost:5432/secureagent_soc

# Redis Cache & Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_ALERTS=soc_alerts
QDRANT_COLLECTION_RULES=soc_rules

# Open Policy Agent (OPA)
OPA_URL=http://localhost:8181

# LLM Serving (vLLM / Ollama Qwen3-8B)
LLM_PROVIDER=mock  # mock | ollama | vllm
LLM_MODEL=qwen3-8b-instruct
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Autonomy & Governance Thresholds (N1–N5 + AEI)
AEI_AUTOCLOSE_THRESHOLD=0.85
AEI_ESCALATE_THRESHOLD=0.60
EMA_ALPHA_REWARD=0.02
EMA_ALPHA_DECAY=0.20
TAINT_CONTAINMENT_THRESHOLD=0.40
MAX_CRITIQUE_ROUNDS=2

