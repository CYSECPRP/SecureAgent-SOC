# Production settings for docker-compose.prod.yml.
# Easiest: run deploy/init-env.sh, which writes .env with random secrets.
# By hand: copy this file to .env in the repository folder and fill in every value.

# Public name of the server. Without a domain, use <server-ip>.sslip.io (for example 203.0.113.10.sslip.io).
# The Red-Team Lab is served at lab.<DOMAIN>.
DOMAIN=

# Random secrets, letters and digits only, at least 32 characters (openssl rand -hex 32).
SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Keys for sensors and scripts (header X-API-Key), comma separated, at least 24 characters each.
API_KEYS=
# Key the Red-Team Lab uses to call the API.
LAB_API_KEY=

# Lab login. Create the hash with: docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains $ signs.
LAB_USER=analyst
LAB_PASSWORD_HASH=''

# Optional
RATE_LIMIT_PER_MINUTE=600
POSTGRES_USER=secureagent
POSTGRES_DB=secureagent_soc
